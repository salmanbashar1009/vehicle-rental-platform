# Environment Configuration (Placeholder values only - copy to .env for local dev)
APP_NAME=VeloFleet API
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://velofleet:velofleet_dev_change_me@localhost:5433/velofleet
TEST_DATABASE_URL=postgresql+asyncpg://velofleet:velofleet_dev_change_me@localhost:5433/velofleet_test

# Redis
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1

# JWT Security (replace with 64-byte random hex in staging/prod)
JWT_SECRET_KEY=replace_with_at_least_32_byte_random_secret_key_for_dev_only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
MFA_ENCRYPTION_KEY=replace_with_32_url_safe_base64_fernet_key_dev

# CORS & Security
CORS_ALLOW_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
MAX_REQUEST_BODY_BYTES=12582912

# Object Storage (S3 / MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_change_me
S3_BUCKET_NAME=velofleet-assets
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://localhost:9000/velofleet-assets

# Business Defaults (BD-01 .. BD-10)
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=UTC
GPS_RETENTION_DAYS=90
SENTRY_DSN=
